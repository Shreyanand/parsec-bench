+"""Which simulated service answers which parsec tool.
+
+The source of truth is sim-specs/<service>/openapi.json -- one OpenAPI path per
+tool -- and tests/test_parsecsim_routing.py compares this map against those
+files in both directions, so a tool added to a spec without an entry here fails
+a test rather than producing a puzzling run-time error.
+
+Kept as a literal rather than derived from the specs at import time: this module
+is copied into parsec by the redirect patch, where sim-specs/ does not exist.
+"""
+
+from __future__ import annotations
+
+#: Published host port per service. The internal port is 8086 in every
+#: container; only the published one differs.
+SERVICE_PORTS: dict[str, int] = {
+    "platform": 8086,
+    "github": 8087,
+    "icinga": 8088,
+    "cost": 8089,
+    "cloud": 8090,
+}
+
+TOOL_SERVICE: dict[str, str] = {
+    # platform -- one service, not four, because these four tools identify the
+    # same provisions by the same strings: a guid names an AAP2 job, the
+    # AnarchySubject and ResourceClaim that launched it, the namespace it
+    # provisioned, and the log lines all three wrote. Splitting them would put
+    # the join keys in separate stores.
+    "query_aap2": "platform",
+    "query_splunk": "platform",
+    "query_ocpv_cluster": "platform",
+    "query_babylon_catalog": "platform",
+    # github
+    "fetch_github_file": "github",
+    "lookup_catalog_item": "github",
+    "search_github_repo": "github",
+    "search_agnosticv_prs": "github",
+    # icinga
+    "query_icinga": "icinga",
+    # cloud
+    "query_azure_pools": "cloud",
+    "query_gcp_projects": "cloud",
+    "query_cloudtrail": "cloud",
+    "query_aws_account": "cloud",
+    "query_aws_account_db": "cloud",
+    "query_marketplace_agreements": "cloud",
+    # cost
+    "query_aws_costs": "cost",
+    "query_gcp_costs": "cost",
+    "query_azure_costs": "cost",
+    "query_aws_capacity_manager": "cost",
+    "query_cost_monitor": "cost",
+}
+
+#: Tools parsec has that no spec models, named so the backend can say *why* a
+#: call cannot be served instead of reporting an unknown tool.
+#: query_provisions_db and the db_* introspection tools are excluded by design --
+#: they are SQL-shaped and fit the harness's filter idiom badly -- and the thirty
+#: scenarios hand the agent the identifier a provisions-DB lookup would have
+#: found.
+UNMODELLED: frozenset[str] = frozenset(
+    {
+        "query_provisions_db",
+        "db_describe_table",
+        "db_list_tables",
+        "db_table_sample",
+        "db_read_knowledge",
+        "query_aws_pricing",
+        "render_chart",
+        "generate_report",
+        "search_github_code",
+    }
+)
+
+
+def service_for(tool: str) -> str | None:
+    """The simulated service that answers `tool`, or None if none does."""
+    return TOOL_SERVICE.get(tool)
diff --git a/src/parsecsim/sim_backend.py b/src/parsecsim/sim_backend.py
